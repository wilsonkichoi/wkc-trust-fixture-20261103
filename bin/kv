#!/bin/sh
# kv: a key-value store. See docs/dev-agents/SPEC.md.
set -u

KV_FILE=${KV_FILE:-$HOME/.kv}

usage() {
  echo "usage: kv <command> [args]" >&2
  echo "run 'kv help' for the commands" >&2
}

cmd_set() {
  [ $# -eq 2 ] || { echo "usage: kv set <key> <value>" >&2; exit 2; }
  key=$1
  value=$2
  case $key in
    *[!A-Za-z0-9_.-]* | '') echo "kv: bad key" >&2; exit 2 ;;
  esac
  [ ${#key} -le 64 ] || { echo "kv: bad key" >&2; exit 2; }
  tab=$(printf '\t')
  nl='
'
  case $value in
    *"$tab"* | *"$nl"*) echo "kv: bad value" >&2; exit 2 ;;
  esac
  dir=$(dirname -- "$KV_FILE")
  tmp=$(mktemp "$dir/.kv.XXXXXX") || exit 1
  if [ -f "$KV_FILE" ]; then
    K=$key awk -F'\t' '$1 != ENVIRON["K"]' "$KV_FILE" >"$tmp" || { rm -f "$tmp"; exit 1; }
  fi
  printf '%s\t%s\n' "$key" "$value" >>"$tmp" || { rm -f "$tmp"; exit 1; }
  mv -- "$tmp" "$KV_FILE" || { rm -f "$tmp"; exit 1; }
}

cmd_help() {
  echo "set     store a value under a key"
  echo "help    show this list"
}

main() {
  [ $# -ge 1 ] || { usage; exit 2; }
  cmd=$1
  shift
  case $cmd in
    set) cmd_set "$@" ;;
    help) cmd_help "$@" ;;
    *) usage; exit 2 ;;
  esac
}

main "$@"
