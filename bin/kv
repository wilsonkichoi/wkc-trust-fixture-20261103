#!/bin/sh
# kv: a key-value store. See docs/dev-agents/SPEC.md.
set -u

KV_FILE=${KV_FILE:-$HOME/.kv}

usage() {
  echo "usage: kv <command> [args]" >&2
  echo "run 'kv help' for the commands" >&2
}

TAB=$(printf '\t')
NL='
'

valid_key() {
  case $1 in
    '' | *[!A-Za-z0-9_.-]*) return 1 ;;
  esac
  [ ${#1} -le 64 ]
}

cmd_set() {
  [ $# -eq 2 ] || { usage; exit 2; }
  key=$1
  value=$2
  valid_key "$key" || { echo "kv: bad key" >&2; exit 2; }
  case $value in
    *"$TAB"* | *"$NL"*) echo "kv: bad value" >&2; exit 2 ;;
  esac
  tmp=$(mktemp "$KV_FILE.XXXXXX") || exit 1
  if [ -f "$KV_FILE" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      case $line in
        "$key$TAB"*) ;;
        *) printf '%s\n' "$line" >>"$tmp" ;;
      esac
    done <"$KV_FILE"
  fi
  printf '%s\t%s\n' "$key" "$value" >>"$tmp"
  mv "$tmp" "$KV_FILE" || { rm -f "$tmp"; exit 1; }
}

cmd_help() {
  echo "set     store a value under a key"
  echo "help    show this list"
}

main() {
  [ $# -ge 1 ] || { usage; exit 2; }
  cmd=$1
  shift
  case $cmd in
    set) cmd_set "$@" ;;
    help) cmd_help "$@" ;;
    *) usage; exit 2 ;;
  esac
}

main "$@"
