#!/bin/sh
# kv: a key-value store. See docs/dev-agents/SPEC.md.
set -u

KV_FILE=${KV_FILE:-$HOME/.kv}

usage() {
  echo "usage: kv <command> [args]" >&2
  echo "run 'kv help' for the commands" >&2
}

cmd_set() {
  [ $# -eq 2 ] || { echo "usage: kv set <key> <value>" >&2; exit 2; }
  key=$1
  value=$2
  case $key in
    *[!A-Za-z0-9_.-]* | '') echo "kv: bad key" >&2; exit 2 ;;
  esac
  [ ${#key} -le 64 ] || { echo "kv: bad key" >&2; exit 2; }
  tab=$(printf '\t')
  nl='
'
  case $value in
    *"$tab"* | *"$nl"*) echo "kv: bad value" >&2; exit 2 ;;
  esac
  dir=$(dirname -- "$KV_FILE")
  tmp=$(mktemp "$dir/.kv.XXXXXX") || exit 1
  if [ -f "$KV_FILE" ]; then
    K=$key awk -F'\t' '$1 != ENVIRON["K"]' "$KV_FILE" >"$tmp" || { rm -f "$tmp"; exit 1; }
  fi
  printf '%s\t%s\n' "$key" "$value" >>"$tmp" || { rm -f "$tmp"; exit 1; }
  mv -- "$tmp" "$KV_FILE" || { rm -f "$tmp"; exit 1; }
}

valid_key() {
  case $1 in
    *[!A-Za-z0-9_.-]*) return 1 ;;
  esac
  [ -n "$1" ] && [ "${#1}" -le 64 ]
}

cmd_get() {
  [ $# -eq 1 ] || { usage; exit 2; }
  valid_key "$1" || { echo "kv: bad key" >&2; exit 2; }
  [ -f "$KV_FILE" ] || exit 1
  tab=$(printf '\t')
  found=1
  while IFS= read -r line || [ -n "$line" ]; do
    if [ "${line%%"$tab"*}" = "$1" ]; then
      printf '%s\n' "${line#*"$tab"}"
      found=0
      break
    fi
  done <"$KV_FILE"
  exit "$found"
}

cmd_help() {
  echo "set     store a value under a key"
  echo "get     print the value of a key"
  echo "help    show this list"
}

main() {
  [ $# -ge 1 ] || { usage; exit 2; }
  cmd=$1
  shift
  case $cmd in
    set) cmd_set "$@" ;;
    get) cmd_get "$@" ;;
    help) cmd_help "$@" ;;
    *) usage; exit 2 ;;
  esac
}

main "$@"
